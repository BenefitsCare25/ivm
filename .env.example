# Database (for production, add ?connection_limit=10&pool_timeout=30)
DATABASE_URL="postgresql://ivm:ivm_dev_password@localhost:5432/ivm_dev?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"

# GitHub OAuth (optional for dev)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
SCRAPE_RETENTION_DAYS="7"  # Auto-delete scrape sessions older than this
PORTAL_KEEPALIVE_MINUTES="15"  # How often to ping cookie-auth portals to keep sessions alive (default 15)

# Deployment-wide ChatGPT OAuth through Codex App Server (no API key)
AI_PROVIDER="codex"
# Optional absolute path to the Codex CLI binary. Defaults to `codex` (`codex.cmd` on Windows).
CODEX_CLI_PATH=""
# Writable, persistent directory owned by the IVM service account. Run the one-time
# `codex login --device-auth` with this directory as CODEX_HOME before starting IVM.
IVM_CODEX_HOME="/var/lib/ivm/codex"
CODEX_REVIEW_MODEL="gpt-5.6-terra"
CODEX_REVIEW_EFFORT="medium"
CODEX_AI_TIMEOUT_MS="300000"
ANTHROPIC_API_KEY="" # Optional outage fallback only

# Encryption (for storing user API keys securely)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Redis (Phase 7+)
REDIS_URL="redis://localhost:6379"

# Feature Flags
FEATURE_BROWSER_WORKSPACE="false"
FEATURE_PDF_FILL="false"
FEATURE_DOCX_FILL="false"

# Logging (use "info" or "warn" in production)
LOG_LEVEL="debug"

# Chrome Extension (optional — for one-click webpage fill)
# Get this ID from chrome://extensions after loading the extension
NEXT_PUBLIC_IVM_EXTENSION_ID=""

# Sentry (optional — error tracking)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ExchangeRate-API (optional — extends currency support beyond MAS 18 currencies)
# Free plan: 1,500 requests/month. Get key at https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=""
